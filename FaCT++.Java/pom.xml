<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- Usual ref to Sonatype OSS repository -->
	<parent>
		<groupId>org.sonatype.oss</groupId>
		<artifactId>oss-parent</artifactId>
		<version>7</version>
	</parent>
	<groupId>net.sourceforge.owlapi</groupId>
	<artifactId>factplusplus</artifactId>
	<packaging>bundle</packaging>
	<version>1.7.0-SNAPSHOT</version>
	<name>FaCT++</name>
	<description>FaCT++ is an OWL 2 DL reasoner</description>
	<url>https://bitbucket.org/dtsarkov/factplusplus</url>
	<issueManagement>
		<system>bitbucket</system>
		<url>https://bitbucket.org/dtsarkov/factplusplus/issues</url>
	</issueManagement>
	<licenses>
		<license>
			<name>LGPL 2.1</name>
			<url>http://www.gnu.org/licenses/lgpl-2.1.html</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>dtsarkov</id>
			<name>Dmitry Tsarkov</name>
		</developer>
	</developers>

	<organization>
		<name>The University of Manchester</name>
		<url>http://www.cs.manchester.ac.uk/</url>
	</organization>

	<profiles>
		<!-- On aarch64 hosts (Apple Silicon, ARM64 Linux) run the tests against the
		     arm64 JNI library. -->
		<profile>
			<id>native-arm64</id>
			<activation>
				<os>
					<arch>aarch64</arch>
				</os>
			</activation>
			<properties>
				<factpp.native.dir>${project.build.directory}/classes/lib/native/arm64</factpp.native.dir>
			</properties>
		</profile>

		<profile>
			<id>release-sign-artifacts</id>
			<activation>
				<activeByDefault>false</activeByDefault>
				<property>
					<name>performRelease</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.4</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>3.3.1</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>
				<version>5.1.9</version>
				<extensions>true</extensions>
				<configuration>
					<instructions>
						<Bundle-SymbolicName>uk.ac.manchester.cs.factplusplus;singleton:=true</Bundle-SymbolicName>
						<Bundle-ManifestVersion>2</Bundle-ManifestVersion>
						<Bundle-Name>Factplusplus Plug-in</Bundle-Name>
						<Bundle-Version>${project.version}</Bundle-Version>
						<Bundle-Vendor>University of Manchester</Bundle-Vendor>
						<Bundle-Description>A Protege OWL wrapper for FaCT++</Bundle-Description>
						<Bundle-ClassPath>.</Bundle-ClassPath>
						<Require-Bundle>org.protege.common,
						 org.protege.editor.core.application,
						 org.protege.editor.owl,
						  org.semanticweb.owl.owlapi</Require-Bundle>

						<!-- One clause per shipped binary, 64-bit only: Protege 5.6.9 needs Java 11+,
						     which has no 32-bit builds for these platforms. macOS is Apple
						     Silicon only; on Intel Macs the bundle does not resolve.
						     Felix (Protege's OSGi framework) normalises the values: Apple Silicon and
						     ARM64 Linux report processor "aarch64" ("arm64" would mean 32-bit ARM);
						     Windows 10 is "windows10", while Windows 11 / Server 2022+ fall back to
						     "win32". -->
						<Bundle-NativeCode>
							lib/native/arm64/libFaCTPlusPlusJNI.jnilib;
								osname=MacOSX ; osname=Mac OS X ; processor=aarch64 ,
							lib/native/arm64/libFaCTPlusPlusJNI.so;
								osname=Linux ; processor=aarch64 ,
							lib/native/64bit/libFaCTPlusPlusJNI.so;
								osname=Linux ; processor=x86_64 ,
							lib/native/64bit/FaCTPlusPlusJNI.dll;
								osname=win32 ; osname=Windows 10 ; osname=Windows Server 2016 ; osname=Windows Server 2019 ;
								osname=Windows 8 ; osname=Windows 7 ; processor=x86_64
						</Bundle-NativeCode>

						<Export-Package>{local-packages}</Export-Package>
						<!-- The Protege and OWL API packages are supplied through Require-Bundle
						     above, so bnd deliberately omits Import-Package entries for them.
						     One OWL API package is imported explicitly to keep a version range
						     in the manifest, so the plug-in refuses to resolve against anything
						     other than OWL API 4.5.x (what Protege 5.6.9 ships). -->
						<!-- !java.* first: java.* is always delegated to the boot class loader
						     and must never appear in Import-Package. The trailing * lets bnd
						     pick up anything else it detects. -->
						<Import-Package>!java.*, uk.ac.manchester.cs.owlapi.modularity, javax.*, *</Import-Package>
					</instructions>
				</configuration>
				<executions>
					<execution>
						<id>bundle-manifest</id>
						<phase>install</phase>
						<goals>
							<goal>manifest</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- In the Compiler Plugin we specify the encoding and the compiler version. -->

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<!-- Built with any JDK 17+ (CI uses 21) but targeting ${maven.compiler.release} bytecode:
					     Protege 5.6.9's platform-specific bundles still ship a JRE 11, so
					     the plug-in must stay loadable there as well as on Java 17+. -->
					<release>${maven.compiler.release}</release>
					<encoding>UTF-8</encoding>
				</configuration>
			</plugin>

			<!-- We need to configure the Source Plugin for deploying the sources. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- We need to configure the Javadoc Plugin for deploying the Javadocs -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.6.3</version>
				<configuration>
					<show>public</show>
					<!-- Modern javadoc runs doclint by default and the existing
					     comments do not satisfy it; keep javadoc non-fatal. -->
					<doclint>none</doclint>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- The Surefire Plugin is for error reporting. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<!-- forkMode was removed in Surefire 3.x -->
					<forkCount>1</forkCount>
					<reuseForks>true</reuseForks>
					<printSummary>false</printSummary>
					<argLine>-Xmx1024M -Djava.awt.headless=true -Djava.library.path=${factpp.native.dir}</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.sonatype.plugins</groupId>
				<artifactId>nexus-staging-maven-plugin</artifactId>
				<version>1.6.13</version>
				<extensions>true</extensions>
				<configuration>
					<serverId>ossrh</serverId>
					<nexusUrl>https://oss.sonatype.org/</nexusUrl>
					<autoReleaseAfterClose>true</autoReleaseAfterClose>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- Specify the encoding of the source files. -->
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- OWL API shipped by Protege 5.6.x (5.6.9 uses owlapi-osgidistribution 4.5.29) -->
		<owlapi.version>4.5.29</owlapi.version>
		<!-- Latest Protege release published to Maven Central; API-compatible with the
		     5.6.9 desktop release, and only needed to compile the optional
		     uk.ac.manchester.cs.factplusplus.protege classes. -->
		<protege.version>5.6.6</protege.version>

		<!-- Bytecode level. 11 keeps the plug-in loadable by the JRE 11 bundled in the
		     platform-specific Protege 5.6.9 distributions while still running on
		     Java 17+. Override with -Dmaven.compiler.release=17 if you only ever run
		     Protege on an external JDK 17 or newer. -->
		<maven.compiler.release>11</maven.compiler.release>

		<!-- Directory searched for the JNI library when running the tests. Defaults to the
		     64bit directory (Linux/Windows x86_64); the native-arm64
		     profile switches it to arm64 on aarch64 hosts.
		     Override with -Dfactpp.native.dir=... to test a different build. -->
		<factpp.native.dir>${project.build.directory}/classes/lib/native/64bit</factpp.native.dir>
	</properties>

	<dependencies>
		<dependency>
			<groupId>net.sourceforge.owlapi</groupId>
			<artifactId>owlapi-distribution</artifactId>
			<version>${owlapi.version}</version>
		</dependency>
		<dependency>
			<groupId>edu.stanford.protege</groupId>
			<artifactId>protege-editor-owl</artifactId>
			<version>${protege.version}</version>
			<optional>true</optional>
			<exclusions>
				<!-- Protege pulls in owlapi-osgidistribution; keep the single OWL API
				     copy declared above on the compile classpath. -->
				<exclusion>
					<groupId>net.sourceforge.owlapi</groupId>
					<artifactId>owlapi-osgidistribution</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
		<!-- Silence slf4j missing class warning. -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-nop</artifactId>
			<version>1.7.36</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
